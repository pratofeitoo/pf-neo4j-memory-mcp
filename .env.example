# Local pilot target. Set secrets only in the process environment.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me
NEO4J_DATABASE=neo4j
MEMORY_WORKSPACE_ID=airtable-pilot

# The local provider is contacted only for document ingestion or semantic search.
MEMORY_EMBEDDING_PROVIDER=ollama
MEMORY_EMBEDDING_MODEL=nomic-embed-text:latest
MEMORY_EMBEDDING_DIMENSIONS=768
MEMORY_OLLAMA_URL=http://127.0.0.1:11434
# Copy the full digest from Ollama /api/tags; update only after reviewing a model change.
MEMORY_OLLAMA_MODEL_DIGEST=replace-with-full-64-character-sha256
# Optional hosted alternative: set MEMORY_EMBEDDING_PROVIDER=openai,
# MEMORY_EMBEDDING_MODEL=text-embedding-3-small, MEMORY_EMBEDDING_DIMENSIONS=1536,
# and OPENAI_API_KEY in the process environment.

# MCP server exposes tools to the configured local Codex client.
