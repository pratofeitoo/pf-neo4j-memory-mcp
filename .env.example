# Local Neo4j only. Do not place real client data in this initial slice.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me
NEO4J_DATABASE=codex-mem-01
MEMORY_WORKSPACE_ID=local-development

# Set OPENAI_API_KEY only if you choose to send synthetic or approved text to OpenAI.
# The embedding provider is not contacted during setup or schema initialization.
OPENAI_API_KEY=
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_DIMENSIONS=1536

# MCP server exposes tools to the configured local Codex client.
